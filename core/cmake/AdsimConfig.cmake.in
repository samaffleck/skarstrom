# AdsimConfig.cmake — CMake package for the adsim (Skarstrom) solver library.
#
#   find_package(Adsim CONFIG REQUIRED)
#   target_link_libraries(my_app PRIVATE Adsim::adsim)
#
# Adsim::adsim is a static library. Its link interface pulls in, from the same
# install prefix:
#   SUNDIALS::ida_static / SUNDIALS::idas_static  (SUNDIALS' own CMake package)
#   muparser::muparser                            (muparser's own CMake package)
#   Adsim::dlib                                   (exported together with adsim)
# Consumers compile as C++20 (propagated via cxx_std_20) and get
# EIGEN_MPL2_ONLY defined. Eigen and cereal are installed under
# include/adsim/third_party and added to the include path.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies installed next to adsim by their own install rules. Hint this
# prefix so the copies adsim was built against are found first.
find_dependency(SUNDIALS CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(muparser CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/AdsimTargets.cmake")

check_required_components(Adsim)
